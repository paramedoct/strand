#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  echo "$0 <alias> [ssh args...]" >&2
  echo "$0 <alias>:<path> [scp args...]" >&2
  exit 1
}

# shellcheck source=/dev/null
source "$ROOT_DIR/utils/source.sh"
source_modules \
  utils/host.sh \
  utils/profile.sh \
  utils/ssh.sh

main() {
  local alias
  local target
  [ "$#" -ge 1 ] || usage
  target=$1
  alias=${target%%:*}
  shift
  profile_prepare
  if ! host_exists "$alias"; then
    return 1
  fi
  host_write_ssh_config "$STRAND_GENERATED_CONFIG_FILE"
  case "$target" in
    *:*)
      ssh_download "$alias" "${target#*:}" "$@"
      return
      ;;
  esac
  exec ssh -F "$STRAND_GENERATED_CONFIG_FILE" "$alias" "$@"
}

main "$@"
